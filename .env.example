# Copy to .env and set a password. .env is gitignored; this file is not.
POSTGRES_USER=midden
POSTGRES_PASSWORD=change-me
POSTGRES_DB=midden
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role used by midden_sql and by the mcp-postgis server.
MIDDEN_RO_USER=midden_ro
MIDDEN_RO_PASSWORD=change-me-too
